{
  "name": "HealthRecord",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "has_diabetes": {
      "type": "boolean",
      "description": "Tem diabetes"
    },
    "has_hypertension": {
      "type": "boolean",
      "description": "Tem hipertens\u00e3o"
    },
    "has_keloid_or_hypertrophic_scar": {
      "type": "boolean",
      "description": "Tem queloide ou cicatriz hipertr\u00f3fica"
    },
    "has_autoimmune_disease": {
      "type": "boolean",
      "description": "Tem doen\u00e7a autoimune"
    },
    "has_anemia": {
      "type": "boolean",
      "description": "Tem anemia"
    },
    "has_fainting_history": {
      "type": "boolean",
      "description": "Tem hist\u00f3rico de desmaio"
    },
    "other_conditions": {
      "type": "string",
      "description": "Outras condi\u00e7\u00f5es cr\u00f4nicas"
    },
    "uses_anticoagulants": {
      "type": "boolean",
      "description": "Usa anticoagulantes"
    },
    "uses_corticosteroids": {
      "type": "boolean",
      "description": "Usa corticoides"
    },
    "uses_roacutan_isotretinoin": {
      "type": "boolean",
      "description": "Usa Roacutan / Isotretino\u00edna"
    },
    "uses_antibiotics": {
      "type": "boolean",
      "description": "Usa antibi\u00f3ticos"
    },
    "uses_antidepressants": {
      "type": "boolean",
      "description": "Usa antidepressivos"
    },
    "other_medications": {
      "type": "string",
      "description": "Outros medicamentos em uso"
    },
    "allergies_latex": {
      "type": "boolean",
      "description": "Alergia a l\u00e1tex"
    },
    "allergies_metals": {
      "type": "boolean",
      "description": "Alergia a metais"
    },
    "allergies_pigments": {
      "type": "boolean",
      "description": "Alergia a pigmentos"
    },
    "allergies_anesthetics": {
      "type": "boolean",
      "description": "Alergia a anest\u00e9sicos"
    },
    "allergies_medications": {
      "type": "boolean",
      "description": "Alergia a medicamentos"
    },
    "allergies_none": {
      "type": "boolean",
      "description": "Nenhuma alergia conhecida"
    },
    "allergies_reaction_details": {
      "type": "string",
      "description": "Detalhes da rea\u00e7\u00e3o al\u00e9rgica"
    },
    "signature_url": {
      "type": "string",
      "description": "URL da assinatura digital"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da assinatura"
    }
  },
  "required": [
    "client_id"
  ]
}