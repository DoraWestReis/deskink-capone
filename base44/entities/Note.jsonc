{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da nota ou tarefa"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado detalhado da nota"
    },
    "category": {
      "type": "string",
      "default": "Outros",
      "description": "Categoria da nota (livre)"
    },
    "is_task": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, a nota \u00e9 tratada como tarefa com prazo"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para conclus\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Prioridade da nota ou tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "archived"
      ],
      "default": "pending",
      "description": "Status atual da nota"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a nota est\u00e1 fixada no topo"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ai",
        "import"
      ],
      "default": "manual",
      "description": "Origem da nota"
    },
    "ai_reason": {
      "type": "string",
      "description": "Justificativa da sugest\u00e3o gerada pela IA"
    },
    "ai_regenerated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da regenera\u00e7\u00e3o (limite di\u00e1rio)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de conclus\u00e3o"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado (legado - usar clients para m\u00faltiplos)"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente vinculado (legado)"
    },
    "clients": {
      "type": "array",
      "description": "Lista de clientes vinculados \u00e0 nota/tarefa",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}