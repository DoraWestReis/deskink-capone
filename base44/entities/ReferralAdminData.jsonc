{
  "name": "ReferralAdminData",
  "type": "object",
  "properties": {
    "referral_id": {
      "type": "string",
      "description": "ID da indica\u00e7\u00e3o vinculada"
    },
    "referral_owner_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que cadastrou a indica\u00e7\u00e3o"
    },
    "contract_signature_date": {
      "type": "string",
      "format": "date",
      "description": "Data de assinatura do contrato"
    },
    "monthly_value": {
      "type": "number",
      "description": "Valor mensal contratado"
    },
    "commission_payment_status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "referral_id",
    "referral_owner_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}